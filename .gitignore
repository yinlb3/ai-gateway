# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
venv/
.env/
.venv/

# Provider credentials: the values are secrets, only the template is
# versioned. config/.env holds the real keys and must never be committed.
config/.env
config/.env.local

# The live gateway configuration, filled in from config.example.yaml. It
# describes one machine, so it is not source.
config/config.yaml

# IDE
.idea/
.vscode/
*.swp

# Tool session data
.kimi/
.claude/

# Raw records: facts collected at runtime, not source
logs/

# Output folders
output/
figures/
ops/
*.log

# Temp folders
temp/
tmp/

# Backup and temp files
*.bak
*.tmpbak
_*.py
!__*__.py
