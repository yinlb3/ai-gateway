# Normalize line endings to LF in the repository, so that a checkout on
# any platform produces the same file.
* text=auto eol=lf

# Shell scripts must stay LF, or they fail to run on Linux.
*.sh text eol=lf

# Batch files are executed by cmd.exe, which expects CRLF.
*.bat text eol=crlf

# Binary files are left untouched.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
